<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jvedio.Core.UserControls.PictureSideMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:config="clr-namespace:Jvedio;assembly=Jvedio"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Jvedio.Core.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:super="https://github.com/SuperStudio/SuperControls"
    d:DesignHeight="450"
    d:DesignWidth="300"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <super:TogglePanel
                Grid.Row="0"
                Margin="1,0"
                Padding="0,4"
                FontSize="14"
                Header="{DynamicResource Default}"
                IsExpanded="{Binding SideDefaultExpanded, Mode=TwoWay, Source={x:Static config:ConfigManager.Main}, UpdateSourceTrigger=PropertyChanged, FallbackValue=true}"
                IsSelected="False"
                LineWidth="0"
                Style="{StaticResource BaseTogglePanel}">
                <StackPanel x:Name="firstStackPanel">
                    <super:PathRadioButton
                        Click="HandleSideClick"
                        GroupName="videoRadioButton"
                        IsChecked="True"
                        MainText="{DynamicResource AllPicture}"
                        Path="{StaticResource GeoVideo}"
                        Style="{StaticResource BasePathRadioButton}"
                        SubText="{Binding AllVideoCount}"
                        Tag="All" />
                    <super:PathRadioButton
                        Click="HandleSideClick"
                        GroupName="videoRadioButton"
                        MainText="{DynamicResource Favorites}"
                        Path="{StaticResource GeoStar}"
                        Style="{StaticResource BasePathRadioButton}"
                        SubText="{Binding FavoriteVideoCount}"
                        Tag="Favorite" />
                    <super:PathRadioButton
                        Click="HandleSideClick"
                        GroupName="videoRadioButton"
                        MainText="{DynamicResource RecentView}"
                        Path="{StaticResource GeoRecentPlay}"
                        Style="{StaticResource BasePathRadioButton}"
                        SubText="{Binding RecentWatchCount}"
                        Tag="RecentWatch">
                        <super:PathRadioButton.ContextMenu>
                            <ContextMenu>
                                <MenuItem Click="ClearRecentWatched" Header="{DynamicResource Clear}" />
                            </ContextMenu>
                        </super:PathRadioButton.ContextMenu>
                    </super:PathRadioButton>

                    <super:PathRadioButton
                        Click="HandleSideClick"
                        GroupName="videoRadioButton"
                        MainText="{DynamicResource MyLabel}"
                        Path="{StaticResource GeoLabel}"
                        Style="{StaticResource BasePathRadioButton}"
                        SubText="{Binding AllLabelCount}"
                        Tag="Label" />
                </StackPanel>
            </super:TogglePanel>

            <super:TogglePanel
                Grid.Row="1"
                Margin="1,0"
                Padding="0,4"
                FontSize="14"
                Header="{DynamicResource PictureFolderTree}"
                IsExpanded="{Binding SideFolderExpanded, Mode=TwoWay, Source={x:Static config:ConfigManager.Main}, UpdateSourceTrigger=PropertyChanged, FallbackValue=true}"
                IsSelected="False"
                LineWidth="0"
                Style="{StaticResource BaseTogglePanel}">
                <TreeView
                    x:Name="folderTreeView"
                    BorderThickness="0"
                    FontSize="13"
                    SelectedItemChanged="FolderTreeView_SelectedItemChanged" />
            </super:TogglePanel>

            <super:TogglePanel
                Grid.Row="2"
                Margin="1,0"
                Padding="0,4"
                FontSize="14"
                Header="{DynamicResource MyPictureCollections}"
                IsExpanded="{Binding SideCollectionExpanded, Mode=TwoWay, Source={x:Static config:ConfigManager.Main}, UpdateSourceTrigger=PropertyChanged, FallbackValue=true}"
                IsSelected="False"
                LineWidth="0"
                Style="{StaticResource BaseTogglePanel}">
                <StackPanel>
                    <Button
                        Margin="4,0,4,6"
                        Click="CreateCollection_Click"
                        Content="{DynamicResource NewPictureCollection}"
                        Style="{StaticResource FlatButton}" />
                    <StackPanel x:Name="collectionStackPanel" />
                </StackPanel>
            </super:TogglePanel>

            <super:TogglePanel
                Grid.Row="3"
                Margin="1,0"
                Padding="0,4"
                FontSize="14"
                Header="{DynamicResource AutoClassification}"
                IsExpanded="{Binding SideClassifyExpanded, Mode=TwoWay, Source={x:Static config:ConfigManager.Main}, UpdateSourceTrigger=PropertyChanged, FallbackValue=true}"
                IsSelected="False"
                LineWidth="0"
                Style="{StaticResource BaseTogglePanel}">

                <StackPanel x:Name="secondStackPanel">
                    <super:PathRadioButton
                        Click="HandleSideClick"
                        GroupName="videoRadioButton"
                        MainText="{DynamicResource Genre}"
                        Path="{StaticResource GeoClassify}"
                        Style="{StaticResource BasePathRadioButton}"
                        SubText="{Binding AllGenreCount}"
                        Tag="Genre" />
                    <super:PathRadioButton
                        Click="HandleSideClick"
                        GroupName="videoRadioButton"
                        MainText="{DynamicResource Author}"
                        Path="{StaticResource GeoClassify}"
                        Style="{StaticResource BasePathRadioButton}"
                        SubText="{Binding AllSeriesCount}"
                        Tag="Series" />
                </StackPanel>
            </super:TogglePanel>

        </Grid>
    </ScrollViewer>

</UserControl>
